<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承 Spring Boot 官方父工程：统一管理依赖版本与插件版本 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.4</version>
    <relativePath/>
  </parent>

  <!-- 项目坐标：groupId 一般写组织/学校域名倒写，artifactId 是项目名 -->
  <groupId>com.example</groupId>
  <artifactId>ai-trial-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>师范专业 AI 试讲台系统</name>
  <description>软件工程课程设计——AI 虚拟试讲训练与考核平台</description>
  <packaging>jar</packaging>

  <properties>
    <!-- 编译目标 Java 版本：字节码目标 17，兼容 JDK 17+ -->
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 第三方依赖版本统一在此声明（对应 docs/技术方案.md 3.2 技术选型） -->
    <mybatis-plus.version>3.5.12</mybatis-plus.version>
    <jjwt.version>0.12.6</jjwt.version>
    <easyexcel.version>4.0.3</easyexcel.version>
    <!-- 显式锁定 Lombok：父工程默认版本在 JDK 23+ 下注解处理器可能失效，锁定兼容版本 -->
    <lombok.version>1.18.48</lombok.version>
    <spotless.version>2.44.5</spotless.version>
    <google-java-format.version>1.25.0</google-java-format.version>
  </properties>

  <dependencies>
    <!-- Web MVC + 内嵌 Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 参数校验（@Valid / @NotBlank 等 JSR-303 注解） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 认证与授权（迭代 1 实现登录注册 + JWT） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- WebSocket：虚拟课堂文字事件流（迭代 4，依赖先行引入） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- 运行监控端点（/actuator/health 等，答辩演示友好） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ORM：MyBatis-Plus（Spring Boot 3 专用 starter） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- 3.5.9+ 分页插件所需：PaginationInnerInterceptor 等拦截器拆分为独立模块 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- MySQL 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JWT（jjwt 三件套，impl 与 jackson 仅运行时需要） -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- EasyExcel：成绩导出（迭代 3） -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>easyexcel</artifactId>
      <version>${easyexcel.version}</version>
    </dependency>

    <!-- Lombok：减少样板代码（IDE 需安装 Lombok 插件；版本见上方 properties） -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 编译插件：JDK 23+ 默认不再隐式运行注解处理器，必须显式开启，
           否则 Lombok(@Data/@Slf4j 等)静默失效，且不报任何错误 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>full</proc>
        </configuration>
      </plugin>

      <!-- Spring Boot 打包插件：mvn package 生成可执行 jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- 代码格式化统一（Google Java Format，AOSP 风格 = 4 空格缩进，贴近国内主流习惯）。
           提交前执行：mvn spotless:apply  检查格式：mvn spotless:check -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
