# 统一换行符：仓库内一律 LF，检出时按平台规则处理
# 团队在 Windows 开发时避免 CRLF/LF 混用导致的 diff 噪音
* text=auto

# 明确指定类型
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Windows 批处理必须 CRLF，Shell 脚本必须 LF
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制文件不转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.doc binary
*.docx binary
*.xlsx binary
*.pptx binary
